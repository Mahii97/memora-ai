# SentenceTransformer model ID or local model directory.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# Optional: override the Hugging Face model cache directory.
# HF_HOME=C:/Users/your-user/.cache/huggingface

# Local CrossEncoder used after hybrid candidate generation.
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=cpu
RERANKER_CANDIDATE_K=20
RERANKER_TOP_K=5

# Optional local Ollama generation. Leave LLM_MODEL empty for retrieval-only mode.
LLM_PROVIDER=ollama
LLM_MODEL=
LLM_BASE_URL=http://127.0.0.1:11434
LLM_TIMEOUT_SECONDS=120

# RAG context and evidence controls.
RAG_MAX_CONTEXT_CHUNKS=5
RAG_MAX_CONTEXT_CHARACTERS=12000
RAG_MIN_RERANKER_SCORE=0.0
# RAG_INSUFFICIENT_EVIDENCE_MESSAGE=
